# Delivery app shares the upload keystore registered in Play Console (see my-app/android/).
# Generate only if setting up a new Play listing:
#   keytool -genkey -v -keystore abhyati-delivery-upload.keystore -alias abhyati-delivery \
#     -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=../../my-app/android/abhyati-customer-upload.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=abhyati-customer
keyPassword=YOUR_KEY_PASSWORD
