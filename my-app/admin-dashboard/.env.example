# Backend origin for API calls (no trailing slash). Use the same host/port as `PORT` in my-app/backend/.env.
# Recommended for local dev:
VITE_API_BASE_URL=http://localhost:3001

# Production / remote API (used when you build the admin app without the line above):
# VITE_API_BASE_URL=https://abhyati-food-customer-delivery-admin-app.onrender.com

# Vite dev proxy target when VITE_API_BASE_URL is unset (apiBase uses same-origin /api in DEV).
# VITE_PROXY_TARGET=http://localhost:3001
