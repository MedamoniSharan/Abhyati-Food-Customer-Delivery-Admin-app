# Backend origin for API calls (no trailing slash). Use the same host/port as `PORT` in my-app/backend/.env.
VITE_API_BASE_URL=http://localhost:3001

# Remote example (e.g. Render) when you are not running the API locally:
# VITE_API_BASE_URL=https://your-api.example.com

# When VITE_API_BASE_URL is empty, the dev server proxies `/api` to this target (see vite.config.ts).
# VITE_PROXY_TARGET=http://localhost:3001
