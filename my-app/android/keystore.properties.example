# Copy to keystore.properties and fill in after creating your upload keystore.
# Generate keystore (run once from my-app/android/):
#   keytool -genkey -v -keystore abhyati-customer-upload.keystore -alias abhyati-customer \
#     -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=abhyati-customer-upload.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=abhyati-customer
keyPassword=YOUR_KEY_PASSWORD
