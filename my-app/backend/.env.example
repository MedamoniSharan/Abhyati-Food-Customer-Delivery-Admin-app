NODE_ENV=development
PORT=4000

# Comma-separated frontend origins allowed for CORS (local + production)
ALLOWED_ORIGINS=http://localhost:5173,https://abhyati-food-customer-app.onrender.com

# Zoho OAuth app credentials
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_long_lived_refresh_token
# Optional: redirect URI registered in Zoho API Console (for npm run zoho:oauth-url / zoho:exchange-code)
# ZOHO_OAUTH_REDIRECT_URI=http://localhost:8080
# Optional: OAuth scopes for the authorize URL (defaults include Books + settings + accountants)
# ZOHO_OAUTH_SCOPE=ZohoBooks.fullaccess.all,ZohoBooks.settings.UPDATE,ZohoBooks.settings.CREATE,ZohoBooks.accountants.READ

# Optional: static access token for debugging only (normally use refresh token above)
# ZOHO_ACCESS_TOKEN=

# Zoho region:
# in, com, eu, com.au, jp, com.cn
ZOHO_REGION=in

# Optional fallback organization id.
# If omitted, backend auto-uses the first org from /organizations endpoint.
ZOHO_ORGANIZATION_ID=

# Invoice defaults
ZOHO_DEFAULT_CURRENCY_CODE=INR
ZOHO_DEFAULT_PAYMENT_TERMS=Due on Receipt

# Default test customer for login (seeded on backend start in dev only)
AUTH_DEFAULT_CUSTOMER_EMAIL=customer@abhyati.com
AUTH_DEFAULT_CUSTOMER_PASSWORD=Abhyati@123
# Production (Render): leave unset/false — seed is skipped. Local dev seeds automatically.
# AUTH_SEED_DEFAULT_CUSTOMER=true

# Admin dashboard (override defaults in production)
ADMIN_EMAIL=admin@abhyati.com
ADMIN_PASSWORD=admin
JWT_SECRET=dev-jwt-secret-change-in-prod-32

# Zoho contact type for new drivers: vendor | customer
DRIVER_ZOHO_CONTACT_TYPE=vendor

# Chart of accounts id from Zoho Books — when set, each customer checkout creates quantity adjustments (stock down)
# ZOHO_INVENTORY_ADJUSTMENT_ACCOUNT_ID=
# Tip: from my-app/backend run `npm run zoho:inventory-account` to list accounts and a suggested id.

# Optional Zoho Books user_id for salesperson on invoices/sales orders (when org requires it). If unset, backend copies salesperson from a recent sales order or invoice, else picks a user whose role name includes "sales".
# ZOHO_DEFAULT_SALESPERSON_ID=
# ZOHO_DEFAULT_SALESPERSON_NAME=

# --- Customer pricing tiers (all optional; omit any to disable tier features) ---
# Create a dedicated Books *customer* contact (e.g. name "_AbhyatiPricingTiers", can mark inactive). Add a Contact
# custom field (multiline or single-line text) for JSON tier list, and another Contact custom field on customers
# for "assigned tier id". Paste the Zoho contact_id and both customfield_ids from Books UI / API.
# ZOHO_PRICING_TIERS_CONTACT_ID=
# ZOHO_CUSTOM_FIELD_TIERS_JSON_ID=
# ZOHO_CUSTOM_FIELD_CUSTOMER_TIER_ID=
# Bootstrap in Zoho + fill the three vars: npm run zoho:setup-pricing-fields   (needs settings.CREATE scope)
# Inspect ids only: npm run zoho:pricing-env -- <catalog_contact_id>

# --- Customer-facing item title (optional) ---
# Create an *Item* custom field in Zoho Books (single-line text), add it to your item layout, then paste its customfield_id here.
# Or auto-create + write .env: npm run zoho:setup-item-customer-display-field   (needs ZohoBooks.settings.CREATE)
# Admin "Customer product name" is saved there; the customer app shows it as the product name. Internal Zoho item name stays read-only in admin.
# ZOHO_CUSTOM_FIELD_ITEM_CUSTOMER_NAME_ID=

# --- Razorpay online payments (Pay now checkout) ---
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=
# Zoho bank account for recording online payments (or auto-pick first active bank account):
# ZOHO_PAYMENT_ACCOUNT_ID=

# --- Product categories (optional; Zoho Books) ---
# List ids + write .env: npm run zoho:product-categories-env   (or: node scripts/show-zoho-product-categories-env.mjs --help via script header)
# Do NOT reuse cf_abhyati_tier_catalog_json — create a **new** multiline contact field for product category JSON.
# ZOHO_PRODUCT_CATEGORIES_CONTACT_ID=
# ZOHO_CUSTOM_FIELD_PRODUCT_CATEGORIES_JSON_ID=
# ZOHO_CUSTOM_FIELD_ITEM_CATEGORY_NAME_ID=
