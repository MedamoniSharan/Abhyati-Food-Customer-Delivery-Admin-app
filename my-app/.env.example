# Local dev — point at your machine (backend must be on PORT, default 3001):
VITE_API_BASE_URL=http://localhost:3001

# Hosted API (production builds / when not using local backend):
# VITE_API_BASE_URL=https://abhyati-food-customer-delivery-admin-app.onrender.com

# Vite proxy target when VITE_API_BASE_URL is unset in dev (same-origin /api).
# VITE_PROXY_TARGET=http://localhost:3001

# Google Maps Embed API (optional). Enable "Maps Embed API" for this key in Google Cloud Console.
# Without it, driver screens still show an "Open in Google Maps" link (uses device location when allowed).
# VITE_GOOGLE_MAPS_API_KEY=
